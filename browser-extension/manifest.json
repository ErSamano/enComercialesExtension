{
  "manifest_version": 3,
  "name": "enComerciales Price Intelligence",
  "version": "0.1.1",
  "description": "Consulta precios históricos de vino y licores mientras compras.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://encomerciales.com/*", "https://www.encomerciales.com/*"],
  "background": { "service_worker": "background/background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["*://*.vinoteca.com/*", "*://*.bodegasalianza.com/*", "*://*.laeuropea.com.mx/*", "*://*.elpalaciodehierro.com/*", "*://*.lacastellana.com/*", "*://*.liverpool.com.mx/*"],
    "js": ["content/inject.js"],
    "run_at": "document_idle"
  }],
  "options_page": "popup/options.html",
  "action": { "default_title": "Consultar enComerciales", "default_popup": "popup/popup.html" }
}
